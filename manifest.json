
{
    "manifest_version": 3,
    "name": "Arev",
    "version": "1.0.0",
    "description": "A beautiful, minimalist new tab that reflects your local weather.",
    "permissions": [
        "storage",
        "geolocation",
        "tabs"
    ],
    "host_permissions": [
        "https://*.open-meteo.com/*",
        "http://*.ip-api.com/*",
        "https://*.bigdatacloud.com/*"
    ],
    "background": {
        "service_worker": "js/background.js",
        "type": "module"
    },
    "chrome_url_overrides": {
        "newtab": "index.html"
    },
    "action": {
        "default_popup": "popup.html"
    },
    "icons": {
        "16": "assets/logo/icon_16.png",
        "48": "assets/logo/icon_48.png",
        "128": "assets/logo/icon_128.png"
    }
}